# Cafe Bazi — environment variables (server-only unless noted).
# Copy to `.env.local` and fill in real values. Never commit real values.

# Neon Postgres connection string (server-only)
DATABASE_URL=postgres://user:password@host.neon.tech/dbname

# Telegram bot token for initData HMAC validation + webhook secret (server-only)
TELEGRAM_BOT_TOKEN=123456789:AAExampleToken

# Random secret for the bot webhook `secret_token` (server-only). Must contain
# only A-Z, a-z, 0-9, '_' and '-' (Telegram rejects ':' and other characters).
# Generate with: node -e "console.log('wbhook_' + require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_SECRET_TOKEN=

# Public bot username (no leading @) used in QR `startapp` deep links (client-visible)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=cafe_bazi_bot

# AES-256-GCM master key for Stellar secrets (server-only).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=

# Stellar network: testnet (default) or mainnet
STELLAR_NETWORK=testnet

# Horizon endpoint for the active network (testnet default; set mainnet when STELLAR_NETWORK=mainnet)
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for the TAK SEP-41 token contract (testnet default; set
# mainnet when STELLAR_NETWORK=mainnet; server-only)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# TAK SEP-41 Soroban token contract address. Setting it activates contract mode:
# SEP-41 `transfer` payments and `("Balance", address)` balance reads via Soroban
# RPC. When unset the app falls back to classic trustline payments (server-only)
TAK_CONTRACT_ID=

# TAK issuer public key (created by `pnpm db:testnet`; server-only)
TAK_ISSUER_PUBLIC_KEY=

# Bearer secret guarding /api/cron/lottery (server-only)
CRON_SECRET=

# JWT signing secret for the MiniApp session cookie (server-only).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# SEP-10 signing key for Stellar Web Authentication (server-only): the keypair
# that issues and verifies Freighter login/link challenges. Must match the home
# domain of NEXT_PUBLIC_APP_URL. Its public key is derived at runtime.
# Generate with: node -e "import('@stellar/stellar-sdk').then(s => console.log(s.Keypair.random().secret()))"
SEP10_SIGNING_KEY=

# Public base URL of the app (used for webhook registration and QR startapp payloads)
NEXT_PUBLIC_APP_URL=http://localhost:3000
